# Quarto build artifacts -- regenerated by `quarto render`, never hand-edited
*_files/
.quarto/
/.quarto/

# Rendered HTML -- regenerate via `quarto render --to html`
*.html

# Jupyter
.ipynb_checkpoints/

# Python
__pycache__/
*.pyc
*.pyo

# Conda / environment artifacts
*.egg-info/

# OS cruft
.DS_Store
Thumbs.db

# Editor
.vscode/
.idea/

# ~/dev-scoped, not project-scoped -- lives at ~/dev/CHEATSHEET.md, shared across every
# project in ~/dev, never tracked by any one project's repo
CHEATSHEET.md
